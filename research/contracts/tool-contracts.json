    {
      "id": "CONTRACT-DIAGNOSE-RECOMMEND-INDEXES",
      "tool": "recommend_indexes",
      "profile": "diagnose",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "sqlite-sample",
        "queries": [
          "SELECT * FROM orders WHERE user_id = 1 AND status = 'completed' ORDER BY created_at DESC"
        ]
      },
      "fixture": "research/fixtures/sample.db",
      "expected_response": {
        "request_id": "req_rec_idx_01",
        "connection": "sqlite-sample",
        "status": "ok",
        "columns": [
          "observed_issue",
          "evidence_timestamp",
          "relevant_queries",
          "suggested_ddl",
          "estimated_benefit",

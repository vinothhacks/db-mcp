    {
      "id": "CONTRACT-QUERY-EXECUTE-READ-OK",
      "tool": "execute_query",
      "profile": "query",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "sqlite-sample",
        "sql": "SELECT id, user_id, status, total_cents FROM orders WHERE status = 'completed' ORDER BY id ASC",
        "max_rows": 2
      },
      "fixture": "research/fixtures/sample.db",
      "expected_response": {
        "request_id": "req_query_01",
        "connection": "sqlite-sample",
        "status": "ok",
        "columns": [
          "id",
          "user_id",
          "status",
          "total_cents"
        ],
        "rows": [
          [
            101,
            1,
            "completed",
            14900
          ],
          [
            102,
            2,
            "completed",
            4900
          ]
        ],
        "returned_rows": 2,
        "truncated": false,
        "warnings": [],
        "schema_version": "snapshot_sqlite_sample"
      },
      "expected_audit": {
        "tool_name": "execute_query",
        "classification": "Read",
        "decision": "Allow"
      }
    },
    {
      "id": "CONTRACT-QUERY-EXECUTE-DENIED-GOVERNED-WRITE",
      "tool": "execute_query",
      "profile": "query",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "prod-governed",
        "sql": "DELETE FROM orders WHERE status = 'cancelled'"
      },
      "fixture": "research/fixtures/sample.db",
      "expected_denial": {
        "status": "denied",
        "code": "APPROVAL_REQUIRED",
        "message": "Production schema or data changes require an approved proposal.",
        "next_action": "propose_change"
      },
      "expected_audit": {
        "tool_name": "execute_query",
        "classification": "WriteDml",
        "decision": "Deny"
      }
    },
    {
      "id": "CONTRACT-QUERY-EXECUTE-DENIED-MUTATING-CTE",
      "tool": "execute_query",
      "profile": "query",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "readonly-conn",
        "sql": "WITH deleted AS (DELETE FROM orders WHERE id = 104 RETURNING *) SELECT * FROM deleted"
      },
      "fixture": "research/fixtures/sample.db",
      "expected_denial": {
        "status": "denied",
        "code": "READONLY_VIOLATION",
        "message": "Data-modifying CTEs are forbidden in ReadOnly and GovernedProduction modes.",
        "next_action": "propose_change"
      }
    },
    {
      "id": "CONTRACT-QUERY-EXECUTE-DENIED-MULTI-STATEMENT",
      "tool": "execute_query",
      "profile": "query",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "readonly-conn",
        "sql": "SELECT 1; DROP TABLE users;"
      },
      "fixture": "research/fixtures/sample.db",
      "expected_denial": {
        "status": "denied",
        "code": "MULTI_STATEMENT_FORBIDDEN",
        "message": "Multi-statement SQL batches are forbidden by policy.",
        "next_action": "split_statements"
      }
    },
    {
      "id": "CONTRACT-QUERY-EXECUTE-DENIED-PRIVILEGED-FUNCTION",
      "tool": "execute_query",
      "profile": "query",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "readonly-conn",
        "sql": "SELECT pg_read_file('/etc/passwd')"
      },
      "fixture": "research/fixtures/sample.db",
      "expected_denial": {
        "status": "denied",
        "code": "PRIVILEGED_FUNCTION_FORBIDDEN",
        "message": "Side-effecting or privileged database function 'pg_read_file' is blocked by policy.",
        "next_action": "remove_privileged_function"
      }
    },
    {
      "id": "CONTRACT-QUERY-EXPLAIN",
      "tool": "explain_query",

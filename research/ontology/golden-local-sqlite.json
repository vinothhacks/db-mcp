      "sql_contains": ["SUM(t0.total_cents)", "WHERE t0.status = ?1"]
    }
  },
  {
    "id": "G11-filter-on-joined-table",
    "question": "total quantity by sku for completed orders",
    "expect": {
      "status": "answerable",

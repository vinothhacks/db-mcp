{
  "name": "@vinoth_n_3000/db-mcp",
  "version": "0.2.1",
  "description": "Self-hosted Rust database MCP server combining schema exploration, bounded SQL execution, PostgreSQL intelligence, declarative named tools, and cryptographically bound change governance.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/vinothhacks/db-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinothhacks/db-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vinothhacks/db-mcp/issues"
  },
  "bin": {
    "db-mcp": "./npm/bin/db-mcp.js"
  },
  "scripts": {
    "build": "cargo build --release -p db-mcp-server",
    "start": "node ./npm/bin/db-mcp.js serve --transport stdio",
    "serve:stdio": "node ./npm/bin/db-mcp.js serve --transport stdio",
    "serve:http": "node ./npm/bin/db-mcp.js serve --transport http",
    "approve": "node ./npm/bin/db-mcp.js approve",
    "init": "node ./npm/bin/db-mcp.js init",
    "install:binary": "node ./npm/bin/db-mcp.js install",
    "verify-config": "node ./npm/bin/db-mcp.js verify-config --config config/db-mcp.example.toml",
    "test": "node ./npm/test/launcher.test.js && node ./npm/test/e2e.test.js",
    "test:e2e": "node ./npm/test/e2e.test.js",
    "test:launcher": "node ./npm/test/launcher.test.js",
    "verify:features": "node ./scripts/feature-smoke.js",
    "selftest": "node ./npm/bin/db-mcp.js selftest"
  },
  "files": [
    "npm/bin/db-mcp.js",
    "config/db-mcp.example.toml",
    "config/db-mcp.starter.toml",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "scripts/feature-smoke.js",
    "scripts/mcp-call.js",
    "scripts/make-isolated-config.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "database",
    "postgresql",
    "mysql",
    "sqlite",
    "sql-governance",
    "coding-agents",
    "claude-code",
    "cursor"
  ]
}

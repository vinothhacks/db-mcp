{
  "schema_version": "1.2.0",
  "description": "DB-MCP canonical tool contracts covering all 24 MCP tools across Explore, Query, Diagnose, Change, Schema and Ontology profiles, including success envelopes, denial envelopes, audit events, and adversarial security cases. Ontology tool contracts: research/contracts/ontology-tools.json.",
  "envelopes": {
    "success": {
      "required_fields": [
        "request_id",
        "connection",
        "status",
        "columns",
        "rows",
        "returned_rows",
        "truncated",
        "warnings",
        "schema_version"
      ],
      "status_value": "ok"
    },
    "denial": {
      "required_fields": [
        "status",
        "code",
        "message",
        "next_action"
      ],
      "status_value": "denied"
    },
    "audit_event": {
      "required_fields": [
        "event_id",
        "timestamp",
        "request_id",
        "principal",
        "connection",
        "tool_name",
        "sql_hash",
        "classification",
        "decision",
        "duration_ms",
        "returned_rows",
        "truncated"
      ]
    }
  },
  "tool_profiles": {
    "explore": [
      "list_connections",
      "search_objects",
      "describe_object",
      "trace_table_dependencies",
      "get_procedure_call_graph"
    ],
    "query": [
      "execute_query",
      "explain_query",
      "run_named_tool"
    ],
    "diagnose": [
      "database_health",
      "analyze_workload",
      "recommend_indexes"
    ],
    "change": [
      "propose_change",
      "get_change",
      "apply_change"
    ],
    "schema": [
      "capture_schema",
      "diff_schema"
    ],
    "ontology": [
      "ontology_status",
      "discover_ontology",
      "search_terms",
      "describe_term",
      "trace_semantic_relationships",
      "propose_semantic_definition",
      "plan_semantic_query",
      "ask_semantic_question"
    ]
  },
  "contracts": [
    {
      "id": "CONTRACT-EXPLORE-LIST-CONNECTIONS",
      "tool": "list_connections",
      "profile": "explore",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {},
      "fixture": "research/fixtures/sample.db",
      "expected_response": {
        "request_id": "req_list_conn_01",
        "connection": "system",
        "status": "ok",
        "columns": [
          "id",
          "engine",
          "mode",
          "read_only",
          "capabilities"
        ],
        "returned_rows": 1,
        "truncated": false,
        "warnings": [],
        "schema_version": "snapshot_initial"
      },
      "security_invariants": [
        "Connection DSNs, passwords, and secret tokens must never appear in rows or metadata."
      ]
    },
    {
      "id": "CONTRACT-EXPLORE-SEARCH-OBJECTS",
      "tool": "search_objects",
      "profile": "explore",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "sqlite-sample",
        "object_type": "table",
        "pattern": "%",
        "detail_level": "summary",
        "limit": 100
      },
      "fixture": "research/fixtures/sample.db",
      "expected_response": {
        "request_id": "req_search_01",
        "connection": "sqlite-sample",
        "status": "ok",
        "columns": [
          "name",
          "schema",
          "column_count",
          "row_count"
        ],
        "returned_rows": 3,
        "truncated": false,
        "warnings": [],
        "schema_version": "snapshot_sqlite_sample"
      },
      "expected_audit": {
        "tool_name": "search_objects",
        "classification": "MetadataRead",
        "decision": "Allow"
      }
    },
    {
      "id": "CONTRACT-EXPLORE-DESCRIBE-OBJECT",
      "tool": "describe_object",

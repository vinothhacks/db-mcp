      }
    },
    {
      "id": "CONTRACT-CHANGE-LIFECYCLE",
      "tool": "propose_change",
      "profile": "change",
      "caller": {
        "principal": "agent:cursor-dev",
        "role": "developer"
      },
      "request": {
        "connection": "prod-governed",
        "sql": "CREATE INDEX idx_users_role ON users(role)",
        "description": "Add index on users.role for role lookup queries"
      },
      "fixture": "research/fixtures/sample.db",
      "expected_response": {
        "request_id": "req_prop_01",
        "connection": "prod-governed",
        "status": "ok",
        "columns": [
          "change_id",
          "state",
          "approval_hash",
          "proposing_principal",
          "schema_fingerprint",
          "reversibility",
          "expires_at"
        ],
        "returned_rows": 1,
        "truncated": false,
        "warnings": [],
        "schema_version": "snapshot_sqlite_sample"
      },
      "governance_invariants": [
        {
          "case": "self_approval_rejected",
          "code": "SELF_APPROVAL_FORBIDDEN",
          "description": "Proposing principal cannot approve its own change proposal."
        },
        {
          "case": "replay_rejected",
          "code": "APPROVAL_ALREADY_CONSUMED",
          "description": "Calling apply_change a second time on an already applied change_id must fail closed."
        },
        {
          "case": "tamper_or_drift_rejected",
          "code": "APPROVAL_HASH_MISMATCH",
          "description": "If SQL, parameters, or schema_fingerprint change after approval, apply_change must fail closed."
        }
      ]
    },
    {

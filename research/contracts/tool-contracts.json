        "request_id": "req_explain_01",
        "connection": "sqlite-sample",
        "status": "ok",
        "columns": [
          "id",
          "parent",
          "notused",
          "detail"
        ],
        "returned_rows": 1,
        "truncated": false,
        "warnings": [],
        "schema_version": "snapshot_sqlite_sample"
      }
    },
    {
      "id": "CONTRACT-QUERY-NAMED-TOOL",

      "status": "answerable",
      "metric": "metric:order_value",
      "dimensions": ["attribute:main.users.role"],
      "filters": ["filter:completed_order"],
      "sql_contains": ["SUM(t0.total_cents)", "JOIN main.users t1 ON t1.id = t0.user_id", "WHERE t0.status = ?1", "GROUP BY t1.role"]

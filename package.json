{
  "name": "db-mcp",
  "version": "0.1.0",
  "description": "Self-hosted Rust database MCP server combining schema exploration, bounded SQL execution, PostgreSQL intelligence, declarative named tools, and cryptographically bound change governance.",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "db-mcp": "./npm/bin/db-mcp.js"
  },
  "scripts": {
    "build": "cargo build --release -p db-mcp-server",
    "start": "node ./npm/bin/db-mcp.js serve --transport stdio",
    "serve:stdio": "node ./npm/bin/db-mcp.js serve --transport stdio",
    "serve:http": "node ./npm/bin/db-mcp.js serve --transport http",
    "approve": "node ./npm/bin/db-mcp.js approve",
    "verify-config": "node ./npm/bin/db-mcp.js verify-config --config config/db-mcp.example.toml",
    "test": "node ./npm/test/e2e.test.js"
  },
  "files": [
    "npm/bin/db-mcp.js",
    "config/db-mcp.example.toml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "postgresql",
    "mysql",
    "sqlite",
    "sql-governance"
  ]
}
